{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "Environment": {
      "type": "string"
    },
    "SubscriptionId": {
      "type": "string"
    },
    "OCCActionGroupResourceGroupName": {
      "type": "string",
      "defaultValue": ""
    },
    "OCCActionGroupName": {
      "type": "string",
      "defaultValue": ""
    },
    "Location": {
      "type": "string"
    },
    "Instance": {
      "type": "string",
      "defaultValue": "dev"
    }
  },
  "variables": {
    "ActionGroupId": "[resourceId(parameters('OCCActionGroupResourceGroupName'),'Microsoft.Insights/actionGroups', parameters('OCCActionGroupName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/activityLogAlerts",
      "apiVersion": "2017-04-01",
      "name": "ResourceHealthAlert",
      "location": "Global",
      "condition": "[or(equals(parameters('Instance'), 'ppe'), equals(parameters('Instance'), 'prod'))]",
      "tags": {
        "TSG": "https://eng.ms/docs/cloud-ai-platform/business-and-industry-copilot/bic-customer-zero/sxg-intelligent-connections/sxg-icon-onecustomer-service/sxg-icon-onecustomer-service-tsg/troubleshooting/sxgchatsupport/newmodalityservice"
      },
      "properties": {
        "enabled": true,
        "scopes": [
          "[subscription().id]",
          "[resourceGroup().id]"
        ],
        "condition": {
          "allOf": [
            {
              "field": "category",
              "equals": "ResourceHealth",
              "containsAny": null
            },
            {
              "anyOf": [
                {
                  "field": "resourceGroup",
                  "equals": "[resourceGroup().id]",
                  "containsAny": null
                }
              ]
            },
            {
              "anyOf": [
                {
                  "field": "properties.currentHealthStatus",
                  "equals": "Available",
                  "containsAny": null
                },
                {
                  "field": "properties.currentHealthStatus",
                  "equals": "Unavailable",
                  "containsAny": null
                },
                {
                  "field": "properties.currentHealthStatus",
                  "equals": "Degraded",
                  "containsAny": null
                }
              ]
            },
            {
              "anyOf": [
                {
                  "field": "properties.previousHealthStatus",
                  "equals": "Available",
                  "containsAny": null
                },
                {
                  "field": "properties.previousHealthStatus",
                  "equals": "Unavailable",
                  "containsAny": null
                },
                {
                  "field": "properties.previousHealthStatus",
                  "equals": "Degraded",
                  "containsAny": null
                }
              ]
            },
            {
              "anyOf": [
                {
                  "field": "properties.cause",
                  "equals": "PlatformInitiated",
                  "containsAny": null
                }
              ]
            },
            {
              "anyOf": [
                {
                  "field": "status",
                  "equals": "Active",
                  "containsAny": null
                },
                {
                  "field": "status",
                  "equals": "Resolved",
                  "containsAny": null
                },
                {
                  "field": "status",
                  "equals": "In Progress",
                  "containsAny": null
                },
                {
                  "field": "status",
                  "equals": "Updated",
                  "containsAny": null
                }
              ]
            }
          ]
        },
        "actions": {
          "actionGroups": [
            {
              "actionGroupId": "[variables('ActionGroupId')]"
            }
          ]
        }
      }
    },
    {
      "name": "ResourceGroupDeleted",
      "type": "Microsoft.Insights/activityLogAlerts",
      "location": "global",
      "condition": "[or(equals(parameters('Instance'), 'ppe'), equals(parameters('Instance'), 'prod'))]",
      "tags": {
        "TSG": "https://eng.ms/docs/cloud-ai-platform/business-and-industry-copilot/bic-customer-zero/sxg-intelligent-connections/sxg-icon-onecustomer-service/sxg-icon-onecustomer-service-tsg/troubleshooting/sxgchatsupport/newmodalityservice"
      },
      "apiVersion": "2017-04-01",
      "properties": {
        "description": "Resource Group Deleted",
        "enabled": true,
        "scopes": [
          "[subscription().id]"
        ],
        "condition": {
          "allOf": [
            {
              "field": "category",
              "equals": "Administrative"
            },
            {
              "field": "operationName",
              "equals": "Microsoft.Resources/subscriptions/resourceGroups/delete"
            }
          ]
        },
        "actions": {
          "actionGroups": [
            {
              "actionGroupId": "[variables('ActionGroupId')]"
            }
          ]
        }
      }
    },
    {
      "name": "FailedDeployment",
      "type": "Microsoft.Insights/activityLogAlerts",
      "location": "global",
      "condition": "[or(equals(parameters('Instance'), 'ppe'), equals(parameters('Instance'), 'prod'))]",
      "tags": {
        "TSG": "https://eng.ms/docs/cloud-ai-platform/business-and-industry-copilot/bic-customer-zero/sxg-intelligent-connections/sxg-icon-onecustomer-service/sxg-icon-onecustomer-service-tsg/troubleshooting/sxgchatsupport/newmodalityservice"
      },
      "apiVersion": "2017-04-01",
      "properties": {
        "description": "Failed ARM Deployment",
        "enabled": true,
        "scopes": [
          "[resourceGroup().id]"
        ],
        "condition": {
          "allOf": [
            {
              "field": "category",
              "equals": "Administrative"
            },
            {
              "field": "resourceType",
              "equals": "Microsoft.Resources/deployments"
            },
            {
              "field": "status",
              "equals": "Failed"
            }
          ]
        },
        "actions": {
          "actionGroups": [
            {
              "actionGroupId": "[variables('ActionGroupId')]"
            }
          ]
        }
      }
    },
    {
      "comments": "Service Health Activity Log Alert",
      "type": "microsoft.insights/activityLogAlerts",
      "apiVersion": "2017-04-01",
      "name": "ServiceHealthActivityLogAlert",
      "location": "Global",
      "condition": "[or(equals(parameters('Instance'), 'ppe'), equals(parameters('Instance'), 'prod'))]",
      "tags": {
        "TSG": "https://eng.ms/docs/cloud-ai-platform/business-and-industry-copilot/bic-customer-zero/sxg-intelligent-connections/sxg-icon-onecustomer-service/sxg-icon-onecustomer-service-tsg/troubleshooting/sxgchatsupport/newmodalityservice"
      },
      "tags": {},
      "scale": null,
      "properties": {
        "scopes": [
          "[subscription().id]"
        ],
        "condition": {
          "allOf": [
            {
              "field": "category",
              "equals": "ServiceHealth"
            },
            {
              "field": "properties.incidentType",
              "equals": "Incident"
            }
          ]
        },
        "actions": {
          "actionGroups": [
            {
              "actionGroupId": "[variables('ActionGroupId')]"
            }
          ]
        },
        "enabled": true,
        "description": ""
      }
    }
  ]
}