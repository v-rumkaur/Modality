{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "Location": {
      "type": "string"
    },
    "Environment": {
      "type": "string"
    },
    "ComponentId": {
      "type": "string"
    },
    "ResourcePrefix": {
      "type": "string"
    },
    "ResourceSuffix": {
      "type": "string",
      "defaultValue": ""
    },
    "UsePremiumSku": {
      "type": "bool",
      "defaultValue": false
    },
    "GlobalResourceGroupName": {
      "type": "string",
      "defaultValue": ""
    },
    "Instance": {
      "type": "string",
      "defaultValue": "dev"
    },
    "OCCActionGroupResourceGroupName": {
      "type": "string",
      "defaultValue": ""
    },
    "OCCActionGroupName": {
      "type": "string",
      "defaultValue": ""
    }
  },
  "variables": {
    "appServicePlanName": "[concat(parameters('ResourcePrefix'), '-serviceplan', parameters('ResourceSuffix'))]",
    "actionGroupId": "[resourceId(parameters('OCCActionGroupResourceGroupName'),'Microsoft.Insights/actionGroups', parameters('OCCActionGroupName'))]",
    "nonPremiumSku": {
      "name": "B1",
      "tier": "Basic",
      "size": "B1",
      "family": "B",
      "capacity": 1
    },
    "premiumSku": {
      "name": "P0v3",
      "tier": "PremiumV3",
      "size": "P0v3",
      "family": "Pv3",
      "capacity": 1
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "name": "[variables('appServicePlanName')]",
      "apiVersion": "2018-02-01",
      "location": "[parameters('Location')]",
      "tags": {
        "env": "[parameters('Environment')]",
        "ComponentId": "[parameters('ComponentId')]"
      },
      "sku": "[if(parameters('UsePremiumSku'), variables('premiumSku'), variables('nonPremiumSku'))]",
      "kind": "app",
      "properties": {
        "perSiteScaling": false
      }
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[format('[Performance] High CPU Utilization Detected ({0})', variables('appServicePlanName'))]",
      "location": "global",
      "condition": "[or(equals(parameters('Instance'), 'ppe'), equals(parameters('Instance'), 'prod'))]",
      "tags": {
        "TSG": "https://eng.ms/docs/cloud-ai-platform/business-and-industry-copilot/bic-customer-zero/sxg-intelligent-connections/sxg-icon-onecustomer-service/sxg-icon-onecustomer-service-tsg/troubleshooting/sxgchatsupport/newmodalityservice"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]"
      ],
      "properties": {
        "description": "App Service Plan CPU Percentage >80%. Function Apps could be running in a degraded state.",
        "severity": 4,
        "enabled": true,
        "scopes": [
          "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]"
        ],
        "evaluationFrequency": "PT15M",
        "windowSize": "PT15M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "criterionType": "StaticThresholdCriterion",
              "name": "CPU Percentage",
              "timeAggregation": "Average",
              "metricName": "CpuPercentage",
              "operator": "GreaterThan",
              "threshold": 80,
              "skipMetricValidation": true
            }
          ]
        },
        "actions": [
          {
            "actionGroupId": "[variables('actionGroupId')]"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[format('[Performance] High Memory Utilization Detected ({0})', variables('appServicePlanName'))]",
      "location": "global",
      "condition": "[or(equals(parameters('Instance'), 'ppe'), equals(parameters('Instance'), 'prod'))]",
      "tags": {
        "TSG": "https://eng.ms/docs/cloud-ai-platform/business-and-industry-copilot/bic-customer-zero/sxg-intelligent-connections/sxg-icon-onecustomer-service/sxg-icon-onecustomer-service-tsg/troubleshooting/sxgchatsupport/newmodalityservice"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]"
      ],
      "properties": {
        "description": "App Service Plan Memory Percentage >80%. Function Apps could be running in a degraded state.",
        "severity": 4,
        "enabled": true,
        "scopes": [
          "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]"
        ],
        "evaluationFrequency": "PT15M",
        "windowSize": "PT15M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "criterionType": "StaticThresholdCriterion",
              "name": "Memory Percentage",
              "timeAggregation": "Average",
              "metricName": "MemoryPercentage",
              "operator": "GreaterThan",
              "threshold": 80,
              "skipMetricValidation": true
            }
          ]
        },
        "actions": [
          {
            "actionGroupId": "[variables('actionGroupId')]"
          }
        ]
      }
    }
  ],
  "outputs": {
    "appServicePlanName": {
      "type": "string",
      "value": "[variables('appServicePlanName')]"
    }
  }
}