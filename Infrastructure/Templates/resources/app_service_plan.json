{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "Location": {
            "type": "string"
        },
        "Environment": {
            "type": "string"
        },
        "ComponentId": {
            "type": "string"
        },
        "ResourcePrefix": {
            "type": "string"
        },
        "ResourceSuffix": {
            "type": "string",
            "defaultValue": ""
        }
    },
    "variables": {
        "appServicePlanName": "[concat(parameters('ResourcePrefix'), '-serviceplan', parameters('ResourceSuffix'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Web/serverfarms",
            "name": "[variables('appServicePlanName')]",
            "apiVersion": "2018-02-01",
            "location": "[parameters('Location')]",
            "tags": {
                "env": "[parameters('Environment')]",
                "ComponentId": "[parameters('ComponentId')]"
            },
            "sku": {
              "name": "S1",
              "tier": "Standard",
              "size": "S1",
              "family": "S",
              "capacity": 1
          },
            "kind": "app",
            "properties": {
                "perSiteScaling": true
            }
        }
    ],
    "outputs": {
        "appServicePlanName": {
            "type": "string",
            "value": "[variables('appServicePlanName')]"
        }
    }
}