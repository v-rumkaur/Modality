{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": { 
        "WafCustomRules": {
            "value": {
                "rules": [
                    {
                        "name": "RateLimitRule",
                        "priority": 99,
                        "ruleType": "RateLimitRule",
                        "rateLimitDurationInMinutes": 5,
                        "rateLimitThreshold": 1500, // 50% more than max expected requests per 5 minutes in PROD
                        "matchConditions": [
                            {
                                "matchVariable": "SocketAddr",
                                "operator": "IPMatch",
                                "negateCondition": false,
                                "matchValue": [
                                    "0.0.0.0/0",
                                    "::/0"
                                ]
                            }
                        ],
                        "action": "Block"
                    }
                ]
            }
        }
    }
}
