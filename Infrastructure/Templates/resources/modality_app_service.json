{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
  "parameters": {
    "Location": {
      "type": "string"
    },
    "Environment": {
      "type": "string"
    },
    "ComponentId": {
      "type": "string"
    },
    "ResourcePrefix": {
      "type": "string"
    },
    "ResourceSuffix": {
      "type": "string",
      "defaultValue": ""
    },
    "GlobalResourceGroupName": {
      "type": "string",
      "defaultValue": ""
    },
    "GlobalResourceSuffix": {
      "type": "string",
      "defaultValue": ""
    },
    "GlobalIdentitySuffix": {
      "type": "string",
      "defaultValue": ""
    },
    "Instance": {
      "type": "string",
      "defaultValue": "dev"
    },
    "GlobalResourceLocation": {
      "type": "string"
    },
    "OCCActionGroupResourceGroupName": {
      "type": "string",
      "defaultValue": ""
    },
    "OCCActionGroupName": {
      "type": "string",
      "defaultValue": ""
    }
  },
  "variables": {
    "appServiceName": "[concat(parameters('ResourcePrefix'), '-appservice', parameters('ResourceSuffix'))]",
    "appServicePlanName": "[concat(parameters('ResourcePrefix'), '-serviceplan', parameters('ResourceSuffix'))]",
    "applicationInsightsName": "[concat(parameters('ResourcePrefix'), '-appinsight', parameters('GlobalResourceSuffix'))]",
    "logAnalyticsWorkspaceName": "[concat(parameters('ResourcePrefix'), '-loganalyticsw', parameters('GlobalResourceSuffix'))]",
    "storageAccountName": "[take(concat(replace(parameters('ResourcePrefix'), '-', ''), 'st', replace(parameters('ResourceSuffix'), '-', '')), 24)]",
    "vnetName": "[concat(parameters('ResourcePrefix'), '-vnet', parameters('ResourceSuffix'))]",
    "subnetName": "[concat(parameters('ResourcePrefix'), '-subnet', parameters('ResourceSuffix'))]",
    "identityName": "[concat(parameters('ResourcePrefix'), '-user-managedidentity', parameters('GlobalIdentitySuffix'))]",
    "actionGroupId": "[resourceId(parameters('OCCActionGroupResourceGroupName'),'Microsoft.Insights/actionGroups', parameters('OCCActionGroupName'))]",
    "pingTestName": "[concat(parameters('ResourcePrefix'), '-Modality2-health', parameters('ResourceSuffix'))]"
  },
    "resources": [
        {
            "type": "Microsoft.Web/sites",
            "apiVersion": "2022-09-01",
            "name": "[variables('appServiceName')]",
            "location": "[parameters('Location')]",
            "tags": {
                "env": "[parameters('Environment')]",
                "ComponentId": "[parameters('ComponentId')]"
            },
            "kind": "app",
            "identity": {
                "type": "UserAssigned",
              "userAssignedIdentities": {
                "[resourceId(parameters('GlobalResourceGroupName'), 'Microsoft.ManagedIdentity/userAssignedIdentities/', variables('identityName'))]": {}
              }
            },
            "properties": {
                "enabled": true,
                "httpsOnly": true,
                "vnetRouteAllEnabled": true,
                "hostNameSslStates": [
                    {
                        "name": "[concat(variables('appServiceName'), '.azurewebsites.net')]",
                        "sslState": "Disabled",
                        "hostType": "Standard"
                    },
                    {
                        "name": "[concat(variables('appServiceName'), '.scm.azurewebsites.net')]",
                        "sslState": "Disabled",
                        "hostType": "Repository"
                    }
                ],
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
                "siteConfig": {
                  "appSettings": [
                    {
                      "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
                      "value": "[reference(resourceId(parameters('GlobalResourceGroupName'), 'Microsoft.Insights/components', variables('applicationInsightsName')), '2015-05-01').InstrumentationKey]"
                    },
                    {
                      "name": "ApplicationInsightsAgent_EXTENSION_VERSION",
                      "value": "~2"
                    },
                    {
                      "name": "AzureWebJobsStorage__accountName",
                      "value": "[variables('storageAccountName')]"
                    },
                    {
                      "name": "AzureWebJobsStorage__clientId",
                      "value": "[reference(resourceId(parameters('GlobalResourceGroupName'), 'Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2018-11-30').clientId]"
                    },
                    {
                      "name": "AzureWebJobsStorage__credential",
                      "value": "managedidentity"
                    },
                    {
                      "name": "BlobServiceUri",
                      "value": "[concat('https://',variables('storageAccountName'),'.blob.core.windows.net')]"
                    },
                    {
                      "name": "ASPNETCORE_ENVIRONMENT",
                      "value": "[parameters('Instance')]"
                    },
                    {
                      "name": "WEBSITE_ENABLE_SYNC_UPDATE_SITE",
                      "value": "true"
                    },
                    {
                      "name": "WEBSITE_RUN_FROM_PACKAGE",
                      "value": "1"
                    }
                  ]
                }
            },
            "resources": [
                {
                    "type": "networkConfig",
                    "apiVersion": "2022-09-01",
                    "name": "virtualNetwork",
                    "dependsOn": [
                        "[resourceId('Microsoft.Web/sites', variables('appServiceName'))]"
                    ],
                    "properties": {
                        "subnetResourceId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('subnetName'))]",
                        "isSwift": true
                    }
                }
            ]
        },
        {
            "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
            "apiVersion": "2022-09-01",
            "name": "[concat(variables('appServiceName'), '/ftp')]",
            "location": "[parameters('Location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/sites', variables('appServiceName'))]"
            ],
            "tags": {
                "env": "[parameters('Environment')]",
                "ComponentId": "[parameters('ComponentId')]"
            },
            "properties": {
                "allow": false
            }
        },
        {
            "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
            "apiVersion": "2022-09-01",
            "name": "[concat(variables('appServiceName'), '/scm')]",
            "location": "[parameters('Location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/sites', variables('appServiceName'))]"
            ],
            "tags": {
                "env": "[parameters('Environment')]",
                "ComponentId": "[parameters('ComponentId')]"
            },
            "properties": {
                "allow": false
            }
        },
        {
            "type": "Microsoft.Web/sites/config",
            "apiVersion": "2022-09-01",
            "name": "[concat(variables('appServiceName'), '/web')]",
            "location": "[parameters('Location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/sites', variables('appServiceName'))]"
            ],
          "properties": {
            "numberOfWorkers": 1,
            "defaultDocuments": [
              "Default.htm",
              "Default.html",
              "Default.asp",
              "index.htm",
              "index.html",
              "iisstart.htm",
              "default.aspx",
              "index.php"
            ],
            "netFrameworkVersion": "v8.0",
            "phpVersion": "5.6",
            "requestTracingEnabled": false,
            "remoteDebuggingEnabled": false,
            "httpLoggingEnabled": false,
            "logsDirectorySizeLimit": 35,
            "detailedErrorLoggingEnabled": false,
            "publishingUsername": "[concat('$', variables('appServiceName'))]",
            "scmType": "None",
            "use32BitWorkerProcess": false,
            "webSocketsEnabled": false,
            "alwaysOn": false,
            "managedPipelineMode": "Integrated",
            "virtualApplications": [
              {
                "virtualPath": "/",
                "physicalPath": "site\\wwwroot",
                "preloadEnabled": true
              }
            ],
            "loadBalancing": "LeastRequests",
            "experiments": {
              "rampUpRules": []
            },
            "autoHealEnabled": false,
            "cors": {
              "allowedOrigins": [
                "https://functions.azure.com",
                "https://functions-staging.azure.com",
                "https://functions-next.azure.com",
                "https://localhost:5001",
                "https://localhost:6001"
              ],
              "supportCredentials": false
            },
            "localMySqlEnabled": false,
            "ipSecurityRestrictions": [
              {
                "ipAddress": "ApplicationInsightsAvailability",
                "action": "Allow",
                "tag": "ServiceTag",
                "priority": 1000,
                "name": "Allow Availability Tests"
              },
              {
                "ipAddress": "AzureFrontDoor.Backend",
                "action": "Allow",
                "tag": "ServiceTag",
                "priority": 1001,
                "name": "Allow Azure Front Door"
              },
              {
                "vnetSubnetResourceId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('subnetName'))]",
                "action": "Allow",
                "tag": "Default",
                "priority": 1002,
                "name": "Allow Local VNet"
              },
              {
                "ipAddress": "Any",
                "action": "Deny",
                "priority": 2147483647,
                "name": "Deny all",
                "description": "Deny all access"
              }
            ],
            "ipSecurityRestrictionsDefaultAction": "[if(or(equals(Parameters('Instance'), 'dev'), equals(Parameters('Instance'), 'int')), 'Allow', 'Deny')]",
            "scmIpSecurityRestrictions": [
              {
                "ipAddress": "Any",
                "action": "Allow",
                "priority": 1,
                "name": "Allow all",
                "description": "Allow all access"
              }
            ],
            "scmIpSecurityRestrictionsUseMain": false,
            "scmIpSecurityRestrictionsDefaultAction": "Allow",
            "http20Enabled": true,
            "minTlsVersion": "1.2",
            "ftpsState": "FtpsOnly",
            "healthCheckPath": "/health"
          }
        },
        {
            "type": "Microsoft.Web/sites/hostNameBindings",
            "apiVersion": "2022-09-01",
            "name": "[concat(variables('appServiceName'), '/', variables('appServiceName'), '.azurewebsites.net')]",
            "location": "[parameters('Location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/sites', variables('appServiceName'))]"
            ],
            "properties": {
                "siteName": "variables('appServiceName')",
                "hostNameType": "Verified"
            }
        },
        {
            // This is supported, there is a bug with the schema validation
            "type": "Microsoft.Insights/diagnosticSettings",
            "apiVersion": "2021-05-01-preview",
            "name": "[concat(variables('appServiceName'), '-diagnosticSettings')]",
            "scope": "[resourceId('Microsoft.Web/sites', variables('appServiceName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/sites', variables('appServiceName'))]"
            ],
            "properties": {
                "workspaceId": "[resourceId(parameters('GlobalResourceGroupName'), 'Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]",
                "logs": [
                    {
                        "categoryGroup": "allLogs",
                        "enabled": true
                    }
                ],
                "metrics": [
                    {
                        "category": "AllMetrics",
                        "enabled": true
                    }
                ]
            }
        },
		// Modality Traffic Pattern Alert
        {
            "type": "Microsoft.Insights/metricAlerts",
            "apiVersion": "2018-03-01",
            "name": "[format('[Traffic Pattern] {0}', variables('appServiceName'))]",
            "location": "global",
            "condition": "[or(equals(parameters('Instance'), 'ppe'), equals(parameters('Instance'), 'prod'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/sites', variables('appServiceName'))]"
            ],
          "properties": {
            "description": "Detected anomaly in total request count.",
            "severity": 4,
            "enabled": true,
            "autoMitigate": true,
            "scopes": [
              "[resourceId('Microsoft.Web/sites', variables('appServiceName'))]"
            ],
            "evaluationFrequency": "PT5M",
            "windowSize": "PT5M",
            "criteria": {
              "odata.type": "Microsoft.Azure.Monitor.MultipleResourceMultipleMetricCriteria",
              "allOf": [
                {
                  "criterionType": "DynamicThresholdCriterion",
                  "name": "Server requests",
                  "timeAggregation": "Total",
                  "metricNamespace": "Microsoft.Web/sites",
                  "metricName": "Requests",
                  "operator": "GreaterOrLessThan",
                  "alertSensitivity": "Low",
                  "failingPeriods": {
                    "numberOfEvaluationPeriods": 3,
                    "minFailingPeriodsToAlert": 3
                  }
                }
              ]
            },
            "actions": [
              {
                "actionGroupId": "[variables('actionGroupId')]"
              }
            ]
          }
        }
    ],
    "outputs": {
        "appServiceName": {
            "type": "string",
            "value": "[variables('appServiceName')]"
        }
    }
}
