    },
    "Environment": {
      "type": "string"
    },
    "ComponentId": {
      "type": "string"
    },
    "ResourcePrefix": {
      "type": "string"
    },
    "ResourceSuffix": {
      "type": "string",
      "defaultValue": ""
    },
    "GlobalResourceGroupName": {
      "type": "string",
      "defaultValue": ""
    },
    "GlobalResourceSuffix": {
      "type": "string",
      "defaultValue": ""
    },
    "GlobalIdentitySuffix": {
      "type": "string",
      "defaultValue": ""
    },
    "Instance": {
      "type": "string",
      "defaultValue": "dev"
    },
    "GlobalResourceLocation": {
      "type": "string"
    },
    "OCCActionGroupResourceGroupName": {
      "type": "string",
      "defaultValue": ""
    },
    "OCCActionGroupName": {
      "type": "string",
      "defaultValue": ""
    }
  },
  "variables": {
