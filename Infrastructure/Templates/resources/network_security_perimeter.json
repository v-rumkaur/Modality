{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "networkSecurityPerimeterName": {
      "type": "string"
    },
    "profileName": {
      "type": "string"
    },
    "Location": {
      "type": "string"
    },
    "resourceAssociations": {
      "type": "string"
    },
    "associationMode": {
      "type": "string",
      "defaultValue": "Learning"
    },
    "ResourcePrefix": {
      "type": "string"
    },
    "GlobalResourceSuffix": {
      "type": "string"
    },
    "storageResourceId": {
      "type": "string"
    },
    "keyVaultResourceId": {
      "type": "string"
    },
    "GlobalResourceLocation": {
      "type": "string"
    }
  },
  "variables": {
    "networkSecurityPerimeterName": "[concat(parameters('ResourcePrefix'), parameters('GlobalResourceSuffix'), '-', parameters('Location'), '-nsp')]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityPerimeters",
      "apiVersion": "2024-06-01-preview",
      "name": "[variables('networkSecurityPerimeterName')]",
      "location": "[parameters('Location')]",
      "properties": {}
    },
    {
      "type": "Microsoft.Network/networkSecurityPerimeters/profiles",
      "apiVersion": "2024-06-01-preview",
      "name": "[format('{0}/{1}', variables('networkSecurityPerimeterName'), parameters('profileName'))]",
      "location": "[parameters('Location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityPerimeters', variables('networkSecurityPerimeterName'))]"
      ],
      "properties": {}
    },
    {
      "type": "Microsoft.Network/networkSecurityPerimeters/resourceAssociations",
      "apiVersion": "2024-06-01-preview",
      "name": "[concat(variables('networkSecurityPerimeterName'), '/', concat(parameters('resourceAssociations'), '-storage'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityPerimeters', variables('networkSecurityPerimeterName'))]",
        "[resourceId('Microsoft.Network/networkSecurityPerimeters/profiles', variables('networkSecurityPerimeterName'), parameters('profileName'))]"
      ],
      "properties": {
        "privateLinkResource": {
          "id": "[parameters('storageResourceId')]"
        },
        "profile": {
          "id": "[resourceId('Microsoft.Network/networkSecurityPerimeters/profiles', variables('networkSecurityPerimeterName'), parameters('profileName'))]"
        },
        "accessMode": "[parameters('associationMode')]"
      }
    },
    {
      "condition": "[and(equals(parameters('GlobalResourceLocation'), 'westus'), not(empty(parameters('keyVaultResourceId'))))]",
      "type": "Microsoft.Network/networkSecurityPerimeters/resourceAssociations",
      "apiVersion": "2024-06-01-preview",
      "name": "[concat(variables('networkSecurityPerimeterName'), '/', concat(parameters('resourceAssociations'), '-keyvault'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityPerimeters', variables('networkSecurityPerimeterName'))]",
        "[resourceId('Microsoft.Network/networkSecurityPerimeters/profiles', variables('networkSecurityPerimeterName'), parameters('profileName'))]"
      ],
      "properties": {
        "privateLinkResource": {
          "id": "[parameters('keyVaultResourceId')]"
        },
        "profile": {
          "id": "[resourceId('Microsoft.Network/networkSecurityPerimeters/profiles', variables('networkSecurityPerimeterName'), parameters('profileName'))]"
        },
        "accessMode": "[parameters('associationMode')]"
      }
    }
  ]
}
