{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "Location": {
            "type": "string"
        },
        "Environment": {
            "type": "string"
        },
        "ComponentId": {
            "type": "string"
        },
        "ResourcePrefix": {
            "type": "string"
        },
        "ResourceSuffix": {
            "type": "string",
            "defaultValue": ""
        }
    },
    "variables": {
        "applicationInsightAppName": "[concat(parameters('ResourcePrefix'), '-appinsight', parameters('ResourceSuffix'))]",
        "logAnalyticsWorkspaceName": "[concat(parameters('ResourcePrefix'), '-loganalyticsw', parameters('ResourceSuffix'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Insights/components",
            "name": "[variables('applicationInsightAppName')]",
            "apiVersion": "2020-02-02",
            "location": "[parameters('Location')]",
            "tags": {
                "env": "[parameters('Environment')]",
                "ComponentId": "[parameters('ComponentId')]"
            },
            "kind": "web",
            "properties": {
                "Application_Type": "web",
                "IngestionMode": "LogAnalytics",
                "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]"
            }
        }
    ],
    "outputs": {
        "applicationInsightAppName": {
            "type": "string",
            "value": "[variables('applicationInsightAppName')]"
        }
    }
}
